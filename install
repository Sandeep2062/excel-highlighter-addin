<#
.SYNOPSIS
    Automated 1-Click Installer for Excel Highlighter Add-in.
    Copies excel-highlighter.xlam and images/ to %APPDATA%\Microsoft\AddIns\ExcelHighlighter
    and activates it automatically in the Windows Registry for Excel.

.DESCRIPTION
    Also clears Excel's ribbon cache (.officeUI files) which can prevent
    customUI XML from add-ins from being loaded. This is the most common
    cause of "add-in shows in Options but ribbon tab doesn't appear".
#>

[CmdletBinding()]
param()

$ErrorActionPreference = "Stop"

$scriptDir = if ($PSScriptRoot) { $PSScriptRoot } else { Split-Path -Parent $MyInvocation.MyCommand.Definition }
if (-not $scriptDir) { $scriptDir = Get-Location }

$xlamSource = Join-Path $scriptDir "excel-highlighter.xlam"
$imagesSource = Join-Path $scriptDir "images"
if (-not (Test-Path $imagesSource)) {
    $imagesSource = Join-Path (Join-Path $scriptDir "customUI") "images"
}

if (-not (Test-Path $xlamSource)) {
    $buildScript = Join-Path (Join-Path $scriptDir "scripts") "build-xlam.ps1"
    if (Test-Path $buildScript) {
        Write-Host "excel-highlighter.xlam not found. Building now..." -ForegroundColor Yellow
        & $buildScript
    }
}

if (-not (Test-Path $xlamSource)) {
    Write-Error "Could not find excel-highlighter.xlam. Please build or download it first."
    exit 1
}

$targetDir = Join-Path $env:APPDATA "Microsoft\AddIns\ExcelHighlighter"
if (-not (Test-Path $targetDir)) {
    New-Item -ItemType Directory -Path $targetDir -Force | Out-Null
}

$targetXlam = Join-Path $targetDir "excel-highlighter.xlam"
$targetImages = Join-Path $targetDir "images"

Write-Host "Installing Excel Highlighter Add-in..." -ForegroundColor Cyan

# Check running Excel instances - we need Excel closed to clear the cache.
$excelProcesses = Get-Process excel -ErrorAction SilentlyContinue
if ($excelProcesses) {
    Write-Host ""
    Write-Host "WARNING: Excel is currently running." -ForegroundColor Yellow
    Write-Host "  Excel must be closed before installation can complete." -ForegroundColor Yellow
    Write-Host "  Please close all Excel windows, then re-run this installer." -ForegroundColor Yellow
    Write-Host ""
    $continue = Read-Host "Force-close Excel now? (y/N)"
    if ($continue -eq "y" -or $continue -eq "Y") {
        $excelProcesses | Stop-Process -Force
        Start-Sleep -Seconds 2
    } else {
        Write-Host "Installation cancelled. Please close Excel and re-run." -ForegroundColor Red
        exit 1
    }
}

# --- Clear Excel's ribbon cache -----------------------------------------------
# The .officeUI file stores ribbon customizations and can prevent add-in
# customUI from loading. Deleting it forces Excel to rebuild the ribbon
# from scratch on next launch, which is exactly what we want.
$officeCacheDir = Join-Path $env:LOCALAPPDATA "Microsoft\Office"
$excelOfficeUI = Join-Path $officeCacheDir "Excel.officeUI"
if (Test-Path $excelOfficeUI) {
    Remove-Item $excelOfficeUI -Force
    Write-Host "  Cleared Excel ribbon cache (Excel.officeUI)" -ForegroundColor Green
}

# Also clear the Office ribbon cache for older Office versions.
$oldCache = Join-Path $env:LOCALAPPDATA "Microsoft\Office\Excel.qat"
if (Test-Path $oldCache) {
    Remove-Item $oldCache -Force
    Write-Host "  Cleared old Excel QAT cache (Excel.qat)" -ForegroundColor Green
}

# --- Copy files ---------------------------------------------------------------
Copy-Item $xlamSource $targetXlam -Force
Unblock-File -Path $targetXlam -ErrorAction SilentlyContinue
Write-Host "  Copied and unblocked add-in at: $targetXlam" -ForegroundColor Green

if (Test-Path $imagesSource) {
    if (-not (Test-Path $targetImages)) {
        New-Item -ItemType Directory -Path $targetImages -Force | Out-Null
    }
    Copy-Item (Join-Path $imagesSource "*") $targetImages -Force
    Write-Host "  Copied UI icons to: $targetImages" -ForegroundColor Green
}

# --- Registry activation for Excel 2010+ --------------------------------------
# 16.0 = 2016/365, 15.0 = 2013, 14.0 = 2010
$officeVersions = @("16.0", "15.0", "14.0")
$activatedCount = 0

foreach ($ver in $officeVersions) {
    $regPath = "HKCU:\Software\Microsoft\Office\$ver\Excel\Options"
    if (Test-Path $regPath) {
        $props = Get-ItemProperty -Path $regPath
        $openKeys = $props.psobject.Properties | Where-Object { $_.Name -like "OPEN*" }
        
        $targetKeyName = $null
        foreach ($prop in $openKeys) {
            if ($prop.Value -like "*excel-highlighter*" -or $prop.Value -like "*excel-crosshair-highlighter*") {
                $targetKeyName = $prop.Name
                break
            }
        }
        
        if ($null -eq $targetKeyName) {
            $nextIndex = 0
            while ($true) {
                $keyName = if ($nextIndex -eq 0) { "OPEN" } else { "OPEN$nextIndex" }
                if (-not ($props.psobject.Properties.Name -contains $keyName)) {
                    $targetKeyName = $keyName
                    break
                }
                $nextIndex++
            }
        }

        $regValue = '/R "' + $targetXlam + '"'
        Set-ItemProperty -Path $regPath -Name $targetKeyName -Value $regValue -Force | Out-Null
        Write-Host "  Activated in Excel $ver Registry ($targetKeyName -> $targetXlam)" -ForegroundColor Green
        $activatedCount++
    }
}

if ($activatedCount -eq 0) {
    Write-Host ""
    Write-Host "  NOTE: No Excel installation found in registry." -ForegroundColor Yellow
    Write-Host "  You may need to manually enable the add-in via:" -ForegroundColor Yellow
    Write-Host "  File > Options > Add-ins > Excel Add-ins > Browse" -ForegroundColor Yellow
}

Write-Host ""
Write-Host "SUCCESS! Excel Highlighter Add-in has been installed." -ForegroundColor Green
Write-Host "Open Microsoft Excel and the 'Highlighter' tab will appear automatically." -ForegroundColor Cyan
Write-Host ""
Write-Host "If the tab does not appear:" -ForegroundColor Yellow
Write-Host "  1. Close Excel completely" -ForegroundColor Yellow
Write-Host "  2. Re-run this installer" -ForegroundColor Yellow
Write-Host "  3. Open Excel - the ribbon cache has been cleared" -ForegroundColor Yellow